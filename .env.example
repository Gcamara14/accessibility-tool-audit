# Copy this file to .env and fill in local-only values.
# Do not commit your real .env file.

# WalmartLLM / Element gateway key.
ELEMENT_API_KEY=

# Headings evaluator backend:
# - walmart-llm
# - cursor-sdk
# - mock is controlled by USE_MOCK_AI=true
AI_BACKEND=walmart-llm

# Default model for WalmartLLM. Override if needed.
WALMART_LLM_MODEL=claude-opus-4

# Optional: override the gateway base URL.
# WALMART_LLM_BASE_URL=https://wmtllmgateway.stage.walmart.com/wmtllmgateway

# Optional personal notes.
# NOTES=
